# Copy to .env and fill in. Never commit a filled-in copy.

HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
HIGGSFIELD_API_BASE_URL=https://api.higgsfield.ai
HIGGSFIELD_NANO_BANANA_ENDPOINT=/nano-banana

# Ordered fallback chain, tried left to right. Confirm which of these your
# account can actually reach before a live run:
#   .\.venv\Scripts\python.exe scripts\higgsfield_smoke_test.py
# 403 not_enough_credits = enabled but unfunded. 404 model_not_found = the model
# is not provisioned for your account, and no retry will fix it.
HIGGSFIELD_MODEL_CHAIN=/nano-banana,/higgsfield-ai/soul/reference,/higgsfield-ai/soul/standard
HIGGSFIELD_MAX_RETRIES=3

# true = fail a photo shot rather than substitute the Gemini fallback silently.
HIGGSFIELD_REQUIRED=false
HIGGSFIELD_POLL_INTERVAL_SECONDS=3
HIGGSFIELD_POLL_TIMEOUT_SECONDS=300
HIGGSFIELD_MAX_INPUT_IMAGES=8

GEMINI_API_KEY=
GEMINI_MODEL=gemini-pro-vision-latest
GEMINI_MAX_RETRIES=1

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_REASONING_EFFORT=medium
ANTHROPIC_MAX_TOKENS=8000

# Project root contains "Staples Assets/" — paths in SKU configs are relative to this.
ASSET_ROOT=.
CONFIG_DIR=./_DEV_HANDOFF/config
PROMPT_DIR=./_DEV_HANDOFF/prompts
OUTPUT_DIR=./outputs

APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
MAX_CONCURRENT_SHOTS=3

# Fail startup when a SKU's source imagery is missing. Defaults to true locally
# and false on Vercel/Lambda, where "Staples Assets/" cannot be deployed.
STRICT_ASSETS=true

# Stage 0: no API keys required. Mock returns acceptance-reference images.
MOCK_MODE=true
