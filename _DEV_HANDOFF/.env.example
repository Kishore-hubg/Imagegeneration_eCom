# =============================================================================
# Staples / Coastwide Image Generation POC - environment template
# -----------------------------------------------------------------------------
# Copy this file to `.env` in the project root and fill in the blanks.
# `.env` must be listed in .gitignore. NEVER commit a filled-in copy.
#
# Every value below is currently EMPTY and must be supplied by
# Pratyoosh Patel (pratyoosh.patel@infovision.com) before the pipeline can run.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. HIGGSFIELD  -  photographic generation via the /nano-banana endpoint
# -----------------------------------------------------------------------------
# Used by: every `photo_overlay` and `graphic_only_with_generated_tiles` shot.
# Higgsfield's API is ASYNCHRONOUS: you POST a job, receive a status_url, and
# poll it (or register a webhook) until the result is ready.
#
# CRITICAL: Higgsfield output URLs expire after 7 days. Download every asset to
# local disk the moment it is produced. Nothing in this pipeline may depend on a
# Higgsfield URL after the moment of generation.

HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
HIGGSFIELD_API_BASE_URL=
HIGGSFIELD_NANO_BANANA_ENDPOINT=

# Tuning - safe defaults, override if needed
HIGGSFIELD_POLL_INTERVAL_SECONDS=3
HIGGSFIELD_POLL_TIMEOUT_SECONDS=300
HIGGSFIELD_MAX_INPUT_IMAGES=8


# -----------------------------------------------------------------------------
# 2. GOOGLE GEMINI  -  vision fidelity gate
# -----------------------------------------------------------------------------
# Used by: Stage 5, the single pass/fail check on each RAW generated photo,
# before any overlay work. Model: Gemini Pro (locked by the architecture).

GEMINI_API_KEY=
GEMINI_MODEL=gemini-pro-vision-latest
GEMINI_MAX_RETRIES=1


# -----------------------------------------------------------------------------
# 3. ANTHROPIC CLAUDE  -  overlay design and layout code generation
# -----------------------------------------------------------------------------
# Used by: every `graphic_only` shot (no vision) and the overlay step of every
# `photo_overlay` shot (with vision on the specific passed photo).
# Model and reasoning effort are locked by the architecture - do not change them
# without Pratyoosh's sign-off.

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_REASONING_EFFORT=medium
ANTHROPIC_MAX_TOKENS=8000


# -----------------------------------------------------------------------------
# 4. LOCAL PATHS
# -----------------------------------------------------------------------------
# ASSET_ROOT must point at the shared "Staples Image Generation" folder.
# Every path inside the SKU config JSONs is relative to ASSET_ROOT.

ASSET_ROOT=./Staples Image Generation
CONFIG_DIR=./_DEV_HANDOFF/config
PROMPT_DIR=./_DEV_HANDOFF/prompts
OUTPUT_DIR=./outputs


# -----------------------------------------------------------------------------
# 5. RUNTIME
# -----------------------------------------------------------------------------

APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# Max shots generated in parallel within a single SKU job.
# Keep at or below 3 until you know the Higgsfield rate limit.
MAX_CONCURRENT_SHOTS=3

# MOCK_MODE=true skips all three external APIs and serves the finished
# `acceptance_reference` image for each shot instead. Build and test the whole
# orchestrator, frontend and packaging flow in mock mode BEFORE any key exists.
# This is the single most useful setting in this file - see 01_BUILD_INSTRUCTIONS
# Stage 0.
MOCK_MODE=true
